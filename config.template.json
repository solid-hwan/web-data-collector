{
  "start_url": "https://example.invalid/list",
  "item_selector": "article",
  "fields": {
    "id": {
      "selector": ".id"
    },
    "title": {
      "selector": "h2"
    }
  },
  "next_selector": "a.next",
  "unique_key": [
