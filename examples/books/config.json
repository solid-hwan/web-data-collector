{
  "start_url": "https://books.toscrape.com/catalogue/page-1.html",
  "item_selector": "article.product_pod",
  "fields": {
    "title": {"selector": "h3 a", "attribute": "title"},
    "url": {"selector": "h3 a", "attribute": "href", "normalize": "url"},
    "price_display": {"selector": ".price_color"},
    "availability": {"selector": ".availability"}
  },
  "next_selector": "li.next a",
  "unique_key": "url",
  "max_pages": 2,
  "max_items": 50,
  "requests_per_second": 1,
  "concurrency": 1
}
